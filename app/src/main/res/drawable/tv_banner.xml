<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Base Deep Obsidian / Elevated Slate Surface (Full-Bleed Borderless) -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="320"
                android:endY="180"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="@color/brand_bg_slate" android:offset="0.0" />
                <item android:color="@color/brand_bg_obsidian" android:offset="0.5" />
                <item android:color="@color/brand_bg_slate" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Left Dual-Corner Radial Glow -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="200"
                android:type="radial">
                <item android:color="#381E50B5" android:offset="0.0" />
                <item android:color="#1A00E5FF" android:offset="0.35" />
                <item android:color="#000D1117" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-Right Dual-Corner Radial Glow -->
    <path android:pathData="M0,0 L320,0 L320,180 L0,180 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="320"
                android:centerY="180"
                android:gradientRadius="200"
                android:type="radial">
                <item android:color="#381E50B5" android:offset="0.0" />
                <item android:color="#1A00E5FF" android:offset="0.35" />
                <item android:color="#000D1117" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left: Colored Infinity Rocket Emblem -->
    <group
        android:scaleX="1.28"
        android:scaleY="1.28"
        android:translateX="18"
        android:translateY="26">
        <path
            android:pathData="M50,10 C38,24 34,42 35,64 M50,10 C62,24 66,42 65,64"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4.5">
            <aapt:attr name="android:strokeColor">
                <gradient android:endX="50" android:endY="90" android:startX="50" android:startY="10" android:type="linear">
                    <item android:color="@color/brand_cyan_electric" android:offset="0.0" />
                    <item android:color="@color/brand_blue_cobalt" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M40,26 L60,26 M50,34.5 A5.5,5.5 0 1,0 50,45.5 A5.5,5.5 0 1,0 50,34.5 Z"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4.2">
            <aapt:attr name="android:strokeColor">
                <gradient android:endX="50" android:endY="90" android:startX="50" android:startY="10" android:type="linear">
                    <item android:color="@color/brand_cyan_electric" android:offset="0.0" />
                    <item android:color="@color/brand_blue_cobalt" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M50,63 C46,56 36,56 36,63 C36,70 46,70 50,63 C54,56 64,56 64,63 C64,70 54,70 50,63 Z M35,51 C26,56 24,66 25,75 L35,67 M65,51 C74,56 76,66 75,75 L65,67 M43,75 L50,89 L57,75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4.5">
            <aapt:attr name="android:strokeColor">
                <gradient android:endX="50" android:endY="90" android:startX="50" android:startY="10" android:type="linear">
                    <item android:color="@color/brand_cyan_electric" android:offset="0.0" />
                    <item android:color="@color/brand_blue_cobalt" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Right: OS (Electric Cyan) + B∞ST (Pure White with fused ∞) — No Divider -->
    <group
        android:pivotX="142"
        android:pivotY="90"
        android:scaleX="1.16"
        android:scaleY="1.16">
        <!-- O -->
        <path
            android:pathData="M148,78 L152,78 A5,5 0 0,1 157,83 L157,97 A5,5 0 0,1 152,102 L148,102 A5,5 0 0,1 143,97 L143,83 A5,5 0 0,1 148,78 Z"
            android:strokeColor="@color/brand_cyan_electric"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />
        <!-- S -->
        <path
            android:pathData="M175,82 A4,4 0 0,0 171,78 L167,78 A4,4 0 0,0 163,82 L163,85 A4,4 0 0,0 167,89 L171,89 A4,4 0 0,1 175,93 L175,98 A4,4 0 0,1 171,102 L167,102 A4,4 0 0,1 163,98"
            android:strokeColor="@color/brand_cyan_electric"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />

        <!-- B -->
        <path
            android:pathData="M189,102 L189,78 L197,78 A4.5,4.5 0 0,1 201.5,82.5 L201.5,85 A4.5,4.5 0 0,1 197,89.5 L189,89.5 M197,89.5 A4.5,4.5 0 0,1 202.5,94 L202.5,97.5 A4.5,4.5 0 0,1 197,102 L189,102"
            android:strokeColor="@color/brand_white_pure"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />
        <!-- Fused Infinity Symbol (∞) -->
        <path
            android:pathData="M222,90 C218.5,82.5 208.5,82.5 208.5,90 C208.5,97.5 218.5,97.5 222,90 C225.5,82.5 235.5,82.5 235.5,90 C235.5,97.5 225.5,97.5 222,90 Z"
            android:strokeColor="@color/brand_white_pure"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />
        <!-- S -->
        <path
            android:pathData="M254,82 A4,4 0 0,0 250,78 L246,78 A4,4 0 0,0 242,82 L242,85 A4,4 0 0,0 246,89 L250,89 A4,4 0 0,1 254,93 L254,98 A4,4 0 0,1 250,102 L246,102 A4,4 0 0,1 242,98"
            android:strokeColor="@color/brand_white_pure"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />
        <!-- T -->
        <path
            android:pathData="M260,78 L275,78 M267.5,78 L267.5,102"
            android:strokeColor="@color/brand_white_pure"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="3.8" />
    </group>

</vector>
