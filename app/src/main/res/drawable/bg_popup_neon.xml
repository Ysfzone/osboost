<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Translucent Glass Card Body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D90D1117"
                android:startColor="#E6131922" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#7300E5FF" />
        </shape>
    </item>
    <!-- Subtle Inner Top Glass Highlight -->
    <item
        android:gravity="top"
        android:left="24dp"
        android:right="24dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
