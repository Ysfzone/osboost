<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/popupCard"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_popup_neon"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <!-- Header: Brand + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/app_name"
                android:textColor="@color/neon_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_neon"
                android:letterSpacing="0.06"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/status_scanning"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rocket Launch Stage -->
        <FrameLayout
            android:id="@+id/rocketStage"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivFlame"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:layout_marginTop="34dp"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/ic_flame" />

            <ImageView
                android:id="@+id/ivRocket"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_rocket"
                android:src="@drawable/ic_rocket" />
        </FrameLayout>

        <!-- Scanning Label -->
        <TextView
            android:id="@+id/tvScanningLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/label_scanning_ram"
            android:textColor="@color/neon_text_secondary"
            android:textSize="13sp" />

        <!-- Results Hero Block (revealed at 1400ms+) -->
        <LinearLayout
            android:id="@+id/llResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAvailableLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_available_ram"
                android:textColor="@color/neon_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHeroRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/neon_text_primary"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeltaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_neon"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/neon_emerald"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Neon Progress Bar -->
        <ProgressBar
            android:id="@+id/pbRam"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_neon" />

        <!-- RAM Sub-metrics -->
        <TextView
            android:id="@+id/tvRamUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/neon_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Optional Silent GitHub Update Button (D-Pad Focusable) -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_update_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnUpdate"
            android:nextFocusDown="@id/btnUpdate"
            android:nextFocusLeft="@id/btnUpdate"
            android:nextFocusRight="@id/btnUpdate"
            android:textAllCaps="false"
            android:textColor="@color/neon_cyan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>

