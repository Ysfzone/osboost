<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/popupCard"
        android:layout_width="430dp"
        android:layout_height="275dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_popup_neon"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="18dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Brand Wordmark (OS B∞ST) + Permanent Active Strategy/Mode Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppTitleOs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="OS "
                android:textColor="@color/brand_cyan_electric"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="B∞ST"
                android:textColor="@color/brand_white_pure"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/llModePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mode_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivModeDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/dot_glow_cyan" />

                <TextView
                    android:id="@+id/tvModeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="@string/mode_standard"
                    android:textColor="@color/brand_cyan_electric"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shared Central Stage (Optically Centered Overlay: Cleaning Stage + Results Stage) -->
        <FrameLayout
            android:id="@+id/centralStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false">

            <!-- Cleaning Stage: Infinity Rocket + Aura + Centered Cleaning... Pill -->
            <LinearLayout
                android:id="@+id/llCleaningStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/rocketStage"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/viewRocketAura"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_rocket_aura" />

                    <ImageView
                        android:id="@+id/ivFlame"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="30dp"
                        android:alpha="0"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flame" />

                    <ImageView
                        android:id="@+id/ivRocket"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_rocket"
                        android:src="@drawable/ic_osboost_rocket" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/llCleaningPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_mode_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:contentDescription="@null"
                        android:src="@drawable/dot_glow_cyan" />

                    <TextView
                        android:id="@+id/tvCleaningStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/status_cleaning"
                        android:textColor="@color/brand_cyan_electric"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Results Stage: Symbol-Only Circular Checkmark + Hero RAM + RAM OPTIMIZED Pill -->
            <LinearLayout
                android:id="@+id/llResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Minimalist Circular Checkmark Badge (Symbol Only, 34dp x 34dp) -->
                <FrameLayout
                    android:id="@+id/flDoneBadge"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_check_circle_cyan"
                    android:contentDescription="@string/status_done">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_cyan" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAvailableLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/label_available_ram"
                    android:textColor="@color/brand_silver_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHeroRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_white_pure"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeltaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_neon"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/brand_cyan_electric"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

        <!-- Neon Progress Bar -->
        <ProgressBar
            android:id="@+id/pbRam"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_neon" />

        <!-- RAM Sub-metrics (invisible during scan to lock fixed height) -->
        <TextView
            android:id="@+id/tvRamUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/brand_silver_muted"
            android:textSize="11sp"
            android:visibility="invisible" />

        <!-- Optional Silent GitHub Update Button (D-Pad Focusable + Pulsing Glow) -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_update_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/btnUpdate"
            android:nextFocusDown="@id/btnUpdate"
            android:nextFocusLeft="@id/btnUpdate"
            android:nextFocusRight="@id/btnUpdate"
            android:textAllCaps="false"
            android:textColor="@color/brand_cyan_electric"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Permanent Attribution & Version Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFooterVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_cyan_electric"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFooterAttribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • By Ysfzone • X / GitHub: @Ysfzone"
                android:textColor="@color/brand_silver_muted"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
